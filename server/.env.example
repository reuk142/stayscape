PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stayscape
# Alternatively configure PGHOST, PGPORT, PGDATABASE, PGUSER and PGPASSWORD.
PGSSL=false
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARACTERS
NODE_ENV=development
# Required for production; exact HTTPS origin, without trailing slash.
# APP_ORIGIN=https://stayscape.example
# Optional: PGPOOL_MAX=10; PGSCHEMA=public
# Optional, needed for uploads; HTTPS image URLs work without these:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Seed host password. Set privately; never commit server/.env.
SEED_DEMO_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
